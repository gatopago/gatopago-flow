{
  "name": "gatopago-flow",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply PAYMENTS_DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply PAYMENTS_DB --local",
    "db:list": "wrangler d1 migrations list PAYMENTS_DB --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test-worker/tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build"
  },
  "dependencies": {
    "@gatopago/shared": "file:vendor/gatopago-shared-3.1.1.tgz",
    "hono": "4.13.7",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "^10.0.1",
    "@gatopago/environment": "file:vendor/gatopago-environment-3.1.1.tgz",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  }
}
